# Configuração de credenciais para os serviços de dados astronômicos
# Renomeie este arquivo para .env e preencha com suas credenciais

# Credenciais SciServer (para SDSS)
SCISERVER_USER=seu_usuario_sciserver
SCISERVER_PASS=sua_senha_sciserver

# Credenciais S-PLUS
SPLUS_USER=seu_usuario_splus
SPLUS_PASS=sua_senha_splus

# Token Hugging Face (para upload de datasets)
# Obtenha seu token em: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=seu_token_huggingface
