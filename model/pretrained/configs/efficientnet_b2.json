{
    "model": {
        "name": "efficientnet_b2",
        "pretrained": true,
        "freeze_backbone": false,
        "dropout_rate": 0.3
    },
    "data": {
        "data_source": "local",
        "data_dir": "data/complete_sdss",
        "metadata_path": null,
        "huggingface_repo": null,
        "image_size": 260,
        "train_split": 0.8,
        "batch_size": 24,
        "num_workers": 2
    },
    "training": {
        "num_epochs": 25,
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "scheduler": "cosine",
        "scheduler_params": {
            "T_max": 25
        },
        "early_stopping": true,
        "patience": 7,
        "save_best": true
    },
    "optimizer": {
        "name": "adam",
        "lr": 0.0003,
        "weight_decay": 0.0001,
        "momentum": 0.9,
        "betas": [0.9, 0.999]
    },
    "loss": {
        "name": "crossentropy",
        "use_class_weights": true,
        "label_smoothing": 0.0
    },
    "experiment": {
        "experiment_name": "galaxy_efficientnet_b2",
        "description": "Treinamento EfficientNet-B2 para classificação binária de galáxias",
        "random_seed": 42,
        "device": "auto",
        "mixed_precision": false
    },
    "logging": {
        "log_dir": "results/logs",
        "save_dir": "results/models",
        "log_interval": 10,
        "save_interval": 1,
        "plot_training": true
    }
}
